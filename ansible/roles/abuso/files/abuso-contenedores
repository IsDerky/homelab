#!/usr/bin/env python3
"""Señales de abuso (minería, escaneos, ataques salientes) de los contenedores de
los servidores de juego, mirando solo desde el host: el cgroup de cada contenedor
y la tabla de conexiones del kernel (conntrack). No entra en los contenedores ni
lee su contenido.

Escribe en el textfile de node-exporter, por servidor (las 8 primeras letras del
uuid, como en la URL del panel):
  contenedor_cpu_segundos_total     CPU usada (para rate())
  contenedor_cpu_limite_nucleos     límite de CPU en núcleos (0 = sin límite)
  contenedor_memoria_bytes          RAM en uso (memory.current sin la caché de ficheros inactiva)
  contenedor_memoria_anon_bytes     RAM propia de los procesos (anon: heap, pilas), sin caché
  contenedor_memoria_limite_bytes   límite de RAM (0 = sin límite)
  contenedor_conexiones_salientes   conexiones abiertas desde el contenedor
  contenedor_destinos_distintos     IPs de destino distintas
  contenedor_syn_sin_respuesta      TCP en SYN_SENT (lo típico de un escaneo)
  contenedor_conexiones_pool        conexiones a puertos típicos de pools de minería
Solo cuenta lo que sale del contenedor (los jugadores que entran no).

Para pruebas: ABUSO_DOCKER_JSON (salida de docker inspect en un fichero),
ABUSO_CONNTRACK (fichero con la salida de conntrack -L), ABUSO_CGROUP (raíz del
cgroup) y ABUSO_SALIDA (fichero .prom).
"""
import ipaddress
import json
import os
import re
import subprocess
import time

SALIDA = os.environ.get("ABUSO_SALIDA", "/var/lib/node-exporter/textfile/abuso.prom")
CGROUP = os.environ.get("ABUSO_CGROUP", "/sys/fs/cgroup")
# Stratum y similares. Sin 7777/8888: los usan juegos y webs de verdad.
PUERTOS_POOL = {int(p) for p in os.environ.get("ABUSO_PUERTOS_POOL", "3333,4444,5555,6666,9999,14433,14444,45560,45700").split(",")}
LINEA = re.compile(r"^(?:ipv[46]\s+\d+\s+)?(tcp|udp)\s+\d+\s+\d+\s+(?:([A-Z_]+)\s+)?src=(\S+)\s+dst=(\S+)\s+sport=\d+\s+dport=(\d+)")


def contenedores():
    """{servidor: {"id", "ips"}} de los contenedores de Wings en marcha."""
    if os.environ.get("ABUSO_DOCKER_JSON"):
        datos = json.load(open(os.environ["ABUSO_DOCKER_JSON"]))
    else:
        ids = subprocess.run(["docker", "ps", "-q", "--filter", "label=Service=Pterodactyl"],
                             capture_output=True, text=True, check=True).stdout.split()
        if not ids:
            return {}
        datos = json.loads(subprocess.run(["docker", "inspect", *ids], capture_output=True, text=True, check=True).stdout)
    r = {}
    for c in datos:
        nombre = c.get("Name", "").lstrip("/")
        redes = (c.get("NetworkSettings") or {}).get("Networks") or {}
        ips = {n.get("IPAddress") for n in redes.values() if n.get("IPAddress")}
        r[nombre[:8]] = {"id": c["Id"], "ips": ips}
    return r


def cgroup(cid):
    for d in (f"{CGROUP}/system.slice/docker-{cid}.scope", f"{CGROUP}/docker/{cid}"):
        if os.path.isdir(d):
            return d
    return None


def cpu(cid):
    """(segundos usados, límite en núcleos) o (None, None) si no hay cgroup."""
    d = cgroup(cid)
    if not d:
        return None, None
    usados = None
    with open(f"{d}/cpu.stat") as f:
        for linea in f:
            if linea.startswith("usage_usec"):
                usados = int(linea.split()[1]) / 1e6
    limite = 0.0
    try:
        cuota, periodo = open(f"{d}/cpu.max").read().split()
        if cuota != "max":
            limite = int(cuota) / int(periodo)
    except (OSError, ValueError):
        pass
    return usados, limite


def memoria(cid):
    """(en uso, anon, límite) en bytes, o (None, None, None) si no hay cgroup.
    En uso = memory.current - inactive_file, como el working set de cAdvisor."""
    d = cgroup(cid)
    if not d:
        return None, None, None
    try:
        actual = int(open(f"{d}/memory.current").read())
    except (OSError, ValueError):
        return None, None, None
    stat = {}
    try:
        with open(f"{d}/memory.stat") as f:
            for linea in f:
                k, _, v = linea.partition(" ")
                stat[k] = int(v)
    except (OSError, ValueError):
        pass
    limite = 0
    try:
        m = open(f"{d}/memory.max").read().strip()
        limite = 0 if m == "max" else int(m)
    except (OSError, ValueError):
        pass
    return max(actual - stat.get("inactive_file", 0), 0), stat.get("anon"), limite


def conexiones():
    if os.environ.get("ABUSO_CONNTRACK"):
        return open(os.environ["ABUSO_CONNTRACK"]).read().splitlines()
    r = subprocess.run(["conntrack", "-L", "-o", "extended"], capture_output=True, text=True)
    return r.stdout.splitlines()


def publica(ip):
    try:
        return ipaddress.ip_address(ip).is_global
    except ValueError:
        return False


def main():
    cs = contenedores()
    por_ip = {ip: s for s, c in cs.items() for ip in c["ips"]}
    cuenta = {s: {"total": 0, "destinos": set(), "syn": 0, "pool": 0} for s in cs}
    for linea in conexiones():
        m = LINEA.match(linea)
        if not m:
            continue
        proto, estado, src, dst, dport = m.groups()
        s = por_ip.get(src)
        if s is None:   # no sale de un contenedor de servidor
            continue
        c = cuenta[s]
        c["total"] += 1
        c["destinos"].add(dst)
        if proto == "tcp" and estado == "SYN_SENT":
            c["syn"] += 1
        if int(dport) in PUERTOS_POOL and publica(dst):
            c["pool"] += 1

    lineas = []

    def metrica(nombre, ayuda, tipo, valores):
        lineas.append(f"# HELP {nombre} {ayuda}")
        lineas.append(f"# TYPE {nombre} {tipo}")
        for s, v in sorted(valores.items()):
            if v is not None:
                # repr y no :g, que se queda en 6 cifras (los bytes y el contador de CPU necesitan todas)
                v = int(v) if float(v).is_integer() else repr(float(v))
                lineas.append(f'{nombre}{{servidor="{s}"}} {v}')

    usos = {s: cpu(c["id"]) for s, c in cs.items()}
    metrica("contenedor_cpu_segundos_total", "CPU usada por el contenedor del servidor", "counter", {s: u[0] for s, u in usos.items()})
    metrica("contenedor_cpu_limite_nucleos", "Límite de CPU del contenedor en núcleos (0 = sin límite)", "gauge", {s: u[1] for s, u in usos.items()})
    mems = {s: memoria(c["id"]) for s, c in cs.items()}
    metrica("contenedor_memoria_bytes", "RAM en uso del contenedor sin la caché de ficheros inactiva", "gauge", {s: m[0] for s, m in mems.items()})
    metrica("contenedor_memoria_anon_bytes", "RAM propia de los procesos del contenedor (anon)", "gauge", {s: m[1] for s, m in mems.items()})
    metrica("contenedor_memoria_limite_bytes", "Límite de RAM del contenedor (0 = sin límite)", "gauge", {s: m[2] for s, m in mems.items()})
    metrica("contenedor_conexiones_salientes", "Conexiones abiertas desde el contenedor", "gauge", {s: c["total"] for s, c in cuenta.items()})
    metrica("contenedor_destinos_distintos", "IPs de destino distintas de las conexiones salientes", "gauge", {s: len(c["destinos"]) for s, c in cuenta.items()})
    metrica("contenedor_syn_sin_respuesta", "Conexiones TCP salientes en SYN_SENT", "gauge", {s: c["syn"] for s, c in cuenta.items()})
    metrica("contenedor_conexiones_pool", "Conexiones salientes a puertos típicos de pools de minería", "gauge", {s: c["pool"] for s, c in cuenta.items()})
    lineas.append("# HELP abuso_contenedores_ultima_pasada_segundos Momento de la última pasada")
    lineas.append("# TYPE abuso_contenedores_ultima_pasada_segundos gauge")
    lineas.append(f"abuso_contenedores_ultima_pasada_segundos {int(time.time())}")

    tmp = SALIDA + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lineas) + "\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, SALIDA)


if __name__ == "__main__":
    main()
