[Unit]
Description=cloudflared
After=network-online.target
Wants=network-online.target

[Service]
# Token cifrado con systemd-creds (rol credenciales); systemd lo descifra en %d al arrancar
LoadCredentialEncrypted=cloudflared-token:/etc/credstore.encrypted/cloudflared-token
Environment=TUNNEL_TOKEN_FILE=%d/cloudflared-token
TimeoutStartSec=0
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --protocol http2
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
