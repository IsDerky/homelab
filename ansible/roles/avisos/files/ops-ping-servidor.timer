[Unit]
Description=Latido al vigilante externo cada 10 minutos

[Timer]
# Hora de reloj fija (:00, :10, :20…). No usar OnUnitActiveSec: activado con el
# sistema ya arrancado se queda sin próxima ejecución y el latido se para.
# Cada latido es una escritura en el KV del Worker (1000 al día en el plan gratis).
OnCalendar=*:0/10
AccuracySec=30s

[Install]
WantedBy=timers.target
