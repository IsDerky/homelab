# {{ ansible_managed }}
[Unit]
Description=node-exporter (métricas del sistema)
Requires=docker.service {{ node_exporter_after }}
After=docker.service network-online.target {{ node_exporter_after }}
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ node_exporter_dir }}
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
