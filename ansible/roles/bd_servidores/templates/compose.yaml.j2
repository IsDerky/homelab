# {{ ansible_managed }}
# data/, postgres/ y mongo/ son las bases de los servidores: no las gestiona
# Ansible, van en el backup como volcado (bd-servidores-volcar).
# Los tres con la red del host escuchando solo en {{ bd_servidores_ip }}: así pasan
# por ufw (lo que publica Docker no) y no chocan con lo que haya en 127.0.0.1.
services:
  mariadb:
    image: {{ bd_servidores_image }}
    container_name: bd-servidores
    restart: unless-stopped
    network_mode: host
    user: "{{ bd_servidores_account.uid | default(0) }}:{{ bd_servidores_account.group | default(0) }}"
    command:
      - --bind-address={{ bd_servidores_ip }}
      - --port={{ bd_servidores_port }}
      - --skip-name-resolve
      - --innodb-buffer-pool-size={{ bd_servidores_buffer_pool }}
    environment:
      MARIADB_ROOT_PASSWORD_FILE: /run/secrets/root
      # root solo desde dentro del contenedor; el panel usa su propio usuario
      MARIADB_ROOT_HOST: localhost
      MARIADB_AUTO_UPGRADE: "1"
    volumes:
      - ./data:/var/lib/mysql
      - ./root-password:/run/secrets/root:ro
      - ./initdb:/docker-entrypoint-initdb.d:ro
    mem_limit: {{ bd_servidores_mem }}
{% if bd_servidores_postgres %}

  postgres:
    image: {{ bd_servidores_postgres_image }}
    container_name: bd-servidores-postgres
    restart: unless-stopped
    network_mode: host
    user: "{{ bd_servidores_account.uid | default(0) }}:{{ bd_servidores_account.group | default(0) }}"
    command:
      - postgres
      - -c
      - listen_addresses={{ bd_servidores_ip }}
      - -c
      - port={{ bd_servidores_postgres_port }}
      - -c
      - hba_file=/etc/postgresql/pg_hba.conf
      - -c
      - password_encryption=scram-sha-256
      - -c
      - shared_buffers={{ bd_servidores_postgres_shared_buffers }}
      - -c
      - max_connections={{ bd_servidores_postgres_max_connections }}
    environment:
      # superusuario con el que la extensión del panel crea bases y roles
      POSTGRES_USER: {{ bd_servidores_panel_user }}
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres
      POSTGRES_DB: postgres
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - ./postgres:/var/lib/postgresql/data
      - ./postgres-password:/run/secrets/postgres:ro
      - ./pg_hba.conf:/etc/postgresql/pg_hba.conf:ro
    shm_size: 128m
    mem_limit: {{ bd_servidores_postgres_mem }}
{% endif %}
{% if bd_servidores_mongo %}

  mongo:
    image: {{ bd_servidores_mongo_image }}
    container_name: bd-servidores-mongo
    restart: unless-stopped
    network_mode: host
    user: "{{ bd_servidores_account.uid | default(0) }}:{{ bd_servidores_account.group | default(0) }}"
    command:
      - mongod
      - --auth
      - --bind_ip={{ bd_servidores_ip }}
      - --port={{ bd_servidores_mongo_port }}
      - --wiredTigerCacheSizeGB={{ bd_servidores_mongo_cache_gb }}
    environment:
      # administrador (root) con el que la extensión del panel crea bases y usuarios
      MONGO_INITDB_ROOT_USERNAME: {{ bd_servidores_panel_user }}
      MONGO_INITDB_ROOT_PASSWORD_FILE: /run/secrets/mongo
    volumes:
      - ./mongo:/data/db
      - ./mongo-config:/data/configdb
      - ./mongo-password:/run/secrets/mongo:ro
    mem_limit: {{ bd_servidores_mongo_mem }}
{% endif %}
