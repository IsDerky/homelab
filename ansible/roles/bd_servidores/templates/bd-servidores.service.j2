# {{ ansible_managed }}
[Unit]
Description=Bases de datos de los servidores de Pterodactyl (MariaDB, PostgreSQL y MongoDB)
Requires=docker.service
After=docker.service network-online.target{{ (' ' ~ bd_servidores_after) if bd_servidores_after else '' }}
Wants=network-online.target
{% if bd_servidores_after %}
# Sin esto no existe la IP a la que se atan
Requires={{ bd_servidores_after }}
{% endif %}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ bd_servidores_dir }}
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
