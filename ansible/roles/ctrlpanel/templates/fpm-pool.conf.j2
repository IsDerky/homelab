; {{ ansible_managed }}
[ctrlpanel]
user = {{ ctrlpanel_user }}
group = {{ ctrlpanel_user }}
; nginx (www-data) es el único que habla con el socket
listen = /run/php/php{{ ctrlpanel_php }}-fpm-ctrlpanel.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = ondemand
pm.max_children = {{ ctrlpanel_fpm_max_children }}
pm.process_idle_timeout = 30s
pm.max_requests = 500

php_admin_value[upload_max_filesize] = 100M
php_admin_value[post_max_size] = 100M
php_admin_flag[expose_php] = off
