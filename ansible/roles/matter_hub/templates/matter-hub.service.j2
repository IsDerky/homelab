# {{ ansible_managed }}
[Unit]
Description=Home Assistant Matter Hub (puente Matter, solo LAN)
Requires=docker.service
After=docker.service network-online.target homeassistant.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ matter_hub_dir }}
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
