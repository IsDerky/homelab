# {{ ansible_managed }}
# Usuario de solo lectura de la BD de CtrlPanel (SELECT en products y derkyu_avisos)
{% if derkyu_hosting_db_password is defined %}
CTRLPANEL_DB_HOST=127.0.0.1
CTRLPANEL_DB_PORT=3306
CTRLPANEL_DB_NAME={{ derkyu_hosting_db_name }}
CTRLPANEL_DB_USER={{ derkyu_hosting_db_user }}
CTRLPANEL_DB_PASSWORD={{ derkyu_hosting_db_password }}
{% else %}
# sin contraseña en el vault: la web usa los planes y novedades de respaldo
{% endif %}
