# {{ ansible_managed }}
# conf/ y work/ son datos de AdGuard (su configuración y estadísticas): no los
# gestiona Ansible, van en el backup.
services:
  adguardhome:
    image: {{ adguard_image }}
    container_name: adguardhome
    restart: unless-stopped
    ports:
      # Solo en la IP de la LAN: 127.0.0.53:53 es de systemd-resolved
      - "{{ adguard_dns_listen }}:53:53/tcp"
      - "{{ adguard_dns_listen }}:53:53/udp"
      # Panel y DoH, solo para nginx
      - "127.0.0.1:{{ adguard_panel_port }}:3000/tcp"
    volumes:
      - ./work:/opt/adguardhome/work
      - ./conf:/opt/adguardhome/conf
{% if adguard_unbound %}
    networks:
      - dns

  # Sin puertos publicados: solo le pregunta AdGuard, por la red del compose
  unbound:
    image: {{ adguard_unbound_image }}
    container_name: unbound
    restart: unless-stopped
    mem_limit: 384m
    volumes:
      # La imagen incluye custom.conf.d/*.conf
      - ./unbound/lan.conf:/etc/unbound/custom.conf.d/lan.conf:ro
    networks:
      dns:
        ipv4_address: {{ adguard_unbound_ip }}

networks:
  dns:
    ipam:
      config:
        - subnet: {{ adguard_network_subnet }}
{% endif %}
