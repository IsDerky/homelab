# {{ ansible_managed }}
MONITOR {{ sai_nombre }}@localhost 1 upsmon {{ sai_upsmon_clave }} primary
MINSUPPLIES 1
SHUTDOWNCMD "{{ sai_apagar_cmd }}"
NOTIFYCMD /usr/local/bin/sai-notificar
POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 15
FINALDELAY 5
# cambio de batería: una vez por semana; sin conexión: los avisos los da sai-aviso
RBWARNTIME 604800
NOCOMMWARNTIME 86400
{% if sai_cortar_salida %}
POWERDOWNFLAG /etc/killpower
{% endif %}

NOTIFYFLAG ONLINE SYSLOG+EXEC
NOTIFYFLAG ONBATT SYSLOG+EXEC
NOTIFYFLAG LOWBATT SYSLOG+EXEC
NOTIFYFLAG COMMOK SYSLOG+EXEC
NOTIFYFLAG COMMBAD SYSLOG+EXEC
NOTIFYFLAG REPLBATT SYSLOG+EXEC
NOTIFYFLAG FSD SYSLOG
NOTIFYFLAG SHUTDOWN SYSLOG
NOTIFYFLAG NOCOMM SYSLOG
NOTIFYFLAG NOPARENT SYSLOG
