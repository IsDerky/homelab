#!/usr/bin/env python3
"""Certificados de emisores raros y dominios parecidos nuevos para los dominios propios.

Uso: vigilancia-dominios  (lee /etc/vigilancia-dominios.json; estado en /var/lib/vigilancia-dominios)
"""

import json
import os
import subprocess
import sys
import time
import urllib.request

CONF = os.environ.get("CONF", "/etc/vigilancia-dominios.json")
ESTADO = os.environ.get("ESTADO", "/var/lib/vigilancia-dominios")
AVISO = os.environ.get("AVISO", "/usr/local/bin/discord-dm")
API = "https://api.certspotter.com/v1/issuances"


def leer(ruta, defecto):
    try:
        with open(ruta) as f:
            return json.load(f)
    except FileNotFoundError:
        return defecto


def guardar(ruta, datos):
    with open(ruta + ".tmp", "w") as f:
        json.dump(datos, f, indent=1)
    os.replace(ruta + ".tmp", ruta)


def avisar(titulo, texto, campos):
    args = [AVISO, "-t", titulo, "-c", "red"]
    for k, v in campos.items():
        args += ["-f", f"{k}={v}"]
    subprocess.run(args + [texto], check=True)


def certificados(dominio, emisores_ok):
    ruta = f"{ESTADO}/ct-{dominio}.json"
    estado = leer(ruta, None)
    despues = (estado or {}).get("despues")
    raros = []
    for _ in range(50):  # páginas; Cert Spotter devuelve unas 100 por página
        url = f"{API}?domain={dominio}&include_subdomains=true&expand=dns_names&expand=issuer"
        if despues:
            url += f"&after={despues}"
        req = urllib.request.Request(url, headers={"User-Agent": "vigilancia-dominios"})
        with urllib.request.urlopen(req, timeout=60) as r:
            pagina = json.load(r)
        if not pagina:
            break
        for c in pagina:
            emisor = c.get("issuer", {}).get("friendly_name") or c.get("issuer", {}).get("name", "?")
            if not any(ok.lower() in emisor.lower() for ok in emisores_ok):
                raros.append((emisor, ", ".join(c.get("dns_names", []))[:300]))
        despues = pagina[-1]["id"]
        time.sleep(2)
    if estado is not None and raros:
        emisor, nombres = raros[0]
        avisar(
            f"Certificado de un emisor raro para {dominio}",
            "Alguien ha conseguido un certificado para tu dominio con una autoridad que no usas. Puede ser un "
            "servicio tuyo nuevo o alguien suplantando la web: revisarlo en crt.sh.",
            {"Emisor": emisor, "Nombres": nombres, "Total": str(len(raros))},
        )
    guardar(ruta, {"despues": despues})
    if estado is None:
        print(f"{dominio}: certificados aprendidos hasta {despues}")


def parecidos(dominio, imagen):
    ruta = f"{ESTADO}/dnstwist-{dominio}.json"
    conocidos = leer(ruta, None)
    r = subprocess.run(
        ["docker", "run", "--rm", imagen, "--registered", "--format", "json", dominio],
        capture_output=True, text=True, check=True, timeout=1800,
    )
    ahora = sorted(
        d["domain"] for d in json.loads(r.stdout or "[]")
        if not d.get("fuzzer", "").endswith("original") and d["domain"] != dominio
    )
    nuevos = [d for d in ahora if conocidos is not None and d not in conocidos]
    if nuevos:
        avisar(
            f"Dominios parecidos a {dominio} registrados",
            "Se han registrado dominios que se parecen al tuyo. Si alguno tiene web o correo, puede ser para "
            "suplantarte: mirarlo y, si hace falta, denunciarlo al registrador.",
            {"Nuevos": ", ".join(nuevos[:10])[:1000], "Total": str(len(nuevos))},
        )
    guardar(ruta, sorted(set(ahora) | set(conocidos or [])))
    if conocidos is None:
        print(f"{dominio}: {len(ahora)} dominios parecidos ya registrados (aprendidos)")


def main():
    os.makedirs(ESTADO, mode=0o700, exist_ok=True)
    conf = leer(CONF, {})
    fallos = 0
    for d in conf.get("dominios", []):
        for paso in (lambda: certificados(d, conf["emisores_ok"]), lambda: parecidos(d, conf["dnstwist"])):
            try:
                paso()
            except Exception as e:  # noqa: BLE001 — un servicio de fuera caído no avisa ni para lo demás
                print(f"{d}: {e}", file=sys.stderr)
                fallos += 1
    sys.exit(1 if fallos else 0)


if __name__ == "__main__":
    main()
