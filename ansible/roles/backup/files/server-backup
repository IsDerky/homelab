#!/bin/bash
# Backups del servidor a Google Drive con restic (vía rclone), cifrados en el
# servidor antes de subirlos, y una segunda copia en un disco local. Cada modo
# tiene su timer de systemd:
#
#   server-backup sistema        cada 6 h: BD de Bentonime y del panel, /etc, scripts…
#   server-backup clientes       a diario: volúmenes y backups de Pterodactyl (y los de los nodos de fuera)
#   server-backup nas            a diario: el NAS (solo a Drive: está en el disco local)
#   server-backup mantenimiento  domingos: libera espacio, verifica y resume
#   server-backup simulacro      primer domingo de mes: restaura en /var/tmp y comprueba
#
# sistema y clientes, después de subir a Drive, hacen la misma copia en el repo
# local (LOCAL_REPO). Si el disco no está o falla, la copia de Drive no se ve
# afectada: el resultado queda en ESTADO y lo vigila Prometheus.
#
#   Manual:  systemctl start --no-block server-backup@sistema
#   Seguir:  journalctl -fu server-backup@sistema
#
# Pterodactyl: los volúmenes de los clientes se copian como archivos desde el
# host, sin ejecutar nada dentro de sus servidores. La copia es "como si se
# fuera la luz" (crash-consistent); por eso se guardan varias versiones.
# -E: el trap ERR (aviso por DM) también salta dentro de las funciones
set -Eeuo pipefail

export RESTIC_REPOSITORY="rclone:gdrive:servidor-backup"
export RESTIC_PASSWORD_FILE=/root/.restic-pass
export RCLONE_CONFIG=/root/.config/rclone/rclone.conf
export RESTIC_CACHE_DIR=/var/cache/restic
# Trozos de 64 MiB en vez de 16: ~4 veces menos archivos y peticiones a Drive,
# que limita bastante a la clave interna de rclone.
export RESTIC_PACK_SIZE=64
# Lo que restic borra va a la papelera de Drive (30 días): red de seguridad si
# alguien con root borrase el repositorio. Es el comportamiento por defecto.

STAGE=/var/backups/server-backup # volcados que se suben junto al resto
BENTO=/home/bentonime/apps/bentonime
VAULT=/opt/vaultwarden/data # si existe, su BD se vuelca como la de Bentonime

SIMULACRO_RESULT=/var/lib/server-backup/simulacro.json # lo lee ops-collect

# Copia local: un repo restic en el disco USB, con la misma contraseña
LOCAL_MOUNT=/srv/backup-local
LOCAL_REPO=$LOCAL_MOUNT/restic

# Un JSON por modo y destino con el último resultado (lo lee ops-exporter)
ESTADO=/var/lib/server-backup/estado

# Nodos de Wings de fuera: antes de clientes se traen sus volúmenes por rsync y
# se suben con los de aquí. En el nodo, la clave solo puede leer
# /var/lib/pterodactyl (rrsync -ro); los nodos no tienen nada de Drive ni la
# contraseña de restic.
NODOS_CONF=/etc/server-backup/nodos # "nombre host" por línea; sin fichero = sin nodos
NODOS_DIR=/var/lib/server-backup/nodos
NODOS_SISTEMA=/var/lib/server-backup/nodos-sistema # config de Wings y estado.json (nodo-export)
NODOS_KEY=/root/.ssh/nodos-backup
NODOS_KNOWN=/root/.ssh/nodos_known_hosts

mode="${1:-}"
step=inicio
started=$(date +%s)
destino=drive

# Resultado de una ejecución. Conserva la fecha del último éxito al fallar.
# Uso: estado <modo> <destino> true|false <antigüedad máxima en s> [error]
estado() {
  install -d -m 755 "$ESTADO"
  python3 - "$ESTADO/$1-$2.json" "$3" "$4" "$(($(date +%s) - started))" "${5:-}" <<'PY'
import json, os, sys, time
path, ok, max_age, secs, error = sys.argv[1:]
try:
    with open(path) as f:
        prev = json.load(f)
except (OSError, ValueError):
    prev = {}
now = int(time.time())
out = {"ok": ok == "true", "at": now, "duration_s": int(secs), "max_age_s": int(max_age),
       "last_ok_at": now if ok == "true" else prev.get("last_ok_at")}
if error:
    out["error"] = error
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(out, f)
os.chmod(tmp, 0o644)
os.replace(tmp, path)
PY
}

# Cada cuánto tiene que haber una copia buena de cada modo (para la alerta)
max_age() {
  case "$1" in
    sistema) echo $((13 * 3600)) ;;
    clientes | nas | nodo-*) echo $((30 * 3600)) ;;
    mantenimiento) echo $((8 * 86400)) ;;
  esac
}

# Resultado del simulacro para el asistente: JSON con el paso y las comprobaciones.
# Uso: simulacro_result true|false [clave=valor ...]
simulacro_result() {
  install -d -m 755 "$(dirname "$SIMULACRO_RESULT")"
  python3 - "$SIMULACRO_RESULT" "$1" "$step" "$(($(date +%s) - started))" "${@:2}" <<'PY'
import json, os, sys
from datetime import datetime, timezone
path, ok, step, secs, *pairs = sys.argv[1:]
checks = {}
for p in pairs:
    k, _, v = p.partition("=")
    checks[k] = int(v) if v.isdigit() else v
out = {"at": datetime.now(timezone.utc).isoformat(), "ok": ok == "true", "duration_s": int(secs), "checks": checks}
if ok != "true":
    out["step"] = step
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(out, f, indent=1)
os.chmod(tmp, 0o644)
os.replace(tmp, path)
PY
}

notify_fail() {
  if [ "$mode" = simulacro ]; then simulacro_result false || true; fi
  if [ -n "$(max_age "${tag:-$mode}")" ]; then
    estado "${tag:-$mode}" "$destino" false "$(max_age "${tag:-$mode}")" "$step" || true
  fi
  # La copia local no avisa por DM: la vigila Prometheus (avisa una vez, no en
  # cada intento fallido si el disco está desconectado)
  [ "$mode" = _local ] && return
  /usr/local/bin/discord-dm -t "❌ Backup fallido ($mode)" -c red \
    -f "Paso=$step" -f "Equipo=$(hostname)" \
    "Revisa \`journalctl -u server-backup@$mode\`." || true
}
trap notify_fail ERR

# Los modos pueden coincidir (p. ej. clientes aún subiendo cuando toca
# sistema): restic espera a que el otro suelte el bloqueo en vez de fallar.
r() { restic --retry-lock 6h "$@"; }

# `restic backup` sale con 3 si la copia se hizo pero algún archivo cambió o
# desapareció mientras se leía (normal en servidores de juego en marcha).
backup() {
  local rc=0
  r backup --one-file-system --exclude-caches "$@" || rc=$?
  if [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ]; then return "$rc"; fi
}

# Qué copia cada modo y cuántas versiones guarda. Lo usan igual Drive y el repo
# local, para que las dos copias sean la misma.
paths_sistema() {
  paths=("$STAGE" /etc /opt /usr/local/bin /root /var/spool/cron /var/www/pterodactyl)
  for f in "$BENTO/.env.production" "$BENTO/data/.stream-secret"; do
    if [ -e "$f" ]; then paths+=("$f"); fi
  done
  # Métricas de Prometheus: se regeneran, y serían hasta 2 GB cada 6 h
  # Cachés de compilación de root: se regeneran solas
  excludes=(--exclude /root/.cache
    --exclude /root/.npm
    --exclude /root/go/pkg
    --exclude /var/www/pterodactyl/node_modules
    --exclude /var/www/pterodactyl/storage/logs
    --exclude /var/www/pterodactyl/storage/framework/cache
    --exclude /opt/honeypot/var
    --exclude /opt/monitoring/data/prometheus
    # La BD de Vaultwarden en uso: va el volcado de STAGE
    --exclude "$VAULT/db.sqlite3*")
  # Todas las de los últimos 7 días, luego 4 semanales y 12 mensuales (1 año)
  keep=(--keep-within 7d --keep-weekly 4 --keep-monthly 12)
}

paths_clientes() {
  paths=(/var/lib/pterodactyl/volumes)
  if [ -d /var/lib/pterodactyl/backups ]; then paths+=(/var/lib/pterodactyl/backups); fi
  if [ -d "$NODOS_DIR" ]; then paths+=("$NODOS_DIR"); fi
  if [ -d "$NODOS_SISTEMA" ]; then paths+=("$NODOS_SISTEMA"); fi
  excludes=()
  keep=(--keep-daily 7 --keep-weekly 4 --keep-monthly 3)
}

paths_nas() {
  paths=(/srv/nas)
  excludes=(--exclude /srv/nas/lost+found)
  keep=(--keep-daily 7 --keep-weekly 4 --keep-monthly 6)
}

# Copia un modo al repositorio actual (RESTIC_REPOSITORY) y caduca lo viejo
copy() {
  tag=$1
  "paths_$tag"
  step="subida ($destino)"
  backup --tag "$tag" "${excludes[@]}" "${paths[@]}"
  step="caducar versiones antiguas ($destino)"
  r forget --tag "$tag" --group-by host,tags "${keep[@]}"
}

# Trae los volúmenes de cada nodo a NODOS_DIR/<nombre> y lo de nodo-export a
# NODOS_SISTEMA/<nombre>. Las carpetas se quedan entre copias, así que solo
# viaja lo que ha cambiado. Un nodo caído no para la copia: se sube lo último
# que se trajo, avisa por DM y queda en ESTADO (nodo-<nombre>-traida), que
# vigila Prometheus.
pull_nodes() {
  [ -f "$NODOS_CONF" ] || return 0
  local nombre host rc started ssh_cmd
  ssh_cmd="ssh -i $NODOS_KEY -o IdentitiesOnly=yes -o UserKnownHostsFile=$NODOS_KNOWN -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=30"
  while read -r nombre host; do
    if [ -z "$nombre" ] || [ "${nombre:0:1}" = "#" ]; then continue; fi
    started=$(date +%s)
    install -d -m 700 "$NODOS_DIR/$nombre" "$NODOS_SISTEMA/$nombre"
    rc=0
    rsync -a --delete --numeric-ids --timeout=300 -e "$ssh_cmd" \
      "root@$host:volumes/" "$NODOS_DIR/$nombre/" </dev/null || rc=$?
    # 24: algún archivo desapareció mientras se copiaba (normal con servidores en marcha)
    if [ "$rc" -eq 0 ] || [ "$rc" -eq 24 ]; then
      rsync -a --delete --timeout=60 -e "$ssh_cmd" \
        "root@$host:nodo/" "$NODOS_SISTEMA/$nombre/" </dev/null || rc=$?
    fi
    if [ "$rc" -eq 0 ] || [ "$rc" -eq 24 ]; then
      estado "nodo-$nombre" traida true "$(max_age nodo-)"
    else
      estado "nodo-$nombre" traida false "$(max_age nodo-)" "rsync salió con $rc"
      /usr/local/bin/discord-dm -t "❌ No se pudo traer $nombre" -c red \
        -f "Nodo=$host" -f "rsync=$rc" \
        "Se sube la última copia que había. Revisa \`journalctl -u server-backup@clientes\`." || true
    fi
  done <"$NODOS_CONF"
}

# Lanza la copia local en otro proceso: su set -e y su ERR no afectan a este, así
# que un fallo del disco USB nunca marca como fallida la copia de Drive
local_copy() {
  "$0" _local "$1" || true
}

case "$mode" in
  sistema)
    install -d -m 700 "$STAGE"
    step="BD de Bentonime"
    sqlite3 "$BENTO/data/anime.db" ".backup '$STAGE/anime.db'"
    if [ -f "$VAULT/db.sqlite3" ]; then
      step="BD de Vaultwarden"
      sqlite3 "$VAULT/db.sqlite3" ".backup '$STAGE/vaultwarden.db'"
    fi
    step="BD del panel"
    mariadb-dump --single-transaction --routines --triggers --databases panel >"$STAGE/panel.sql"
    step="lista de paquetes"
    dpkg --get-selections >"$STAGE/paquetes.txt"

    copy sistema
    estado sistema drive true "$(max_age sistema)"
    # Mismos volcados que acaban de subir a Drive
    local_copy sistema
    ;;

  clientes)
    step="traer los nodos"
    pull_nodes
    copy clientes
    estado clientes drive true "$(max_age clientes)"
    local_copy clientes
    ;;

  nas)
    copy nas
    estado nas drive true "$(max_age nas)"
    ;;

  # Interno: server-backup _local <modo>
  _local)
    tag="${2:?Uso: server-backup _local sistema|clientes|mantenimiento}"
    destino=local
    # Misma RESTIC_CACHE_DIR que Drive: restic separa la caché por repositorio
    export RESTIC_REPOSITORY="$LOCAL_REPO"
    step="disco local montado"
    mountpoint -q "$LOCAL_MOUNT"
    [ -f "$LOCAL_REPO/config" ]
    if [ "$tag" = mantenimiento ]; then
      step="liberar espacio (local)"
      r prune --max-unused 10%
      # En local es rápido: se lee y comprueba todo, cada semana
      step="verificación completa (local)"
      r check --read-data
    else
      copy "$tag"
    fi
    estado "$tag" local true "$(max_age "$tag")"
    ;;

  mantenimiento)
    step="liberar espacio"
    r prune --max-unused 10%

    step="verificación"
    # Rota por semanas: en 4 domingos se ha descargado y comprobado todo el repo.
    part=$((10#$(date +%V) % 4 + 1))
    r check --read-data-subset="$part/4"

    step="resumen"
    count() { r snapshots --tag "$1" --json | python3 -c "import json,sys; print(len(json.load(sys.stdin)))"; }
    stats=$(r stats --mode raw-data --json)
    size=$(python3 -c "import json,sys; print('%.1f GB' % (json.load(sys.stdin)['total_size'] / 2**30))" <<<"$stats")
    about=$(rclone about gdrive: --json)
    free=$(python3 -c "import json,sys; print('%.1f GB' % (json.load(sys.stdin)['free'] / 2**30))" <<<"$about")
    trash=$(python3 -c "import json,sys; print('%.1f GB' % (json.load(sys.stdin).get('trashed', 0) / 2**30))" <<<"$about")
    estado mantenimiento drive true "$(max_age mantenimiento)"

    # Después de Drive, para que el resumen diga cómo ha ido también el local
    local_copy mantenimiento
    local_ok=$(python3 -c "import json,sys; print('verificado entero' if json.load(open(sys.argv[1])).get('ok') else 'FALLIDO')" \
      "$ESTADO/mantenimiento-local.json" 2>/dev/null || echo "sin datos")

    /usr/local/bin/discord-dm -t "📦 Resumen semanal de backups" -c green \
      -f "Versiones sistema=$(count sistema)" -f "Versiones clientes=$(count clientes)" \
      -f "Versiones NAS=$(count nas)" -f "Copia local=$local_ok" \
      -f "Ocupa el repo=$size" -f "Papelera de Drive=$trash" -f "Libre en Drive=$free" \
      "Espacio liberado y verificada la parte $part de 4 del repositorio sin errores." || true
    ;;

  simulacro)
    # Lo que haría falta si muriese el disco: ¿se puede sacar del repositorio y sirve?
    work=$(mktemp -d /var/tmp/simulacro.XXXXXX)
    trap 'rm -rf "$work"' EXIT
    dumps="$work$STAGE"

    step="restaurar los volcados de sistema"
    r restore latest --tag sistema --target "$work" --include "$STAGE"

    step="integridad de anime.db"
    [ "$(sqlite3 "$dumps/anime.db" 'PRAGMA integrity_check')" = ok ]
    animes=$(sqlite3 "$dumps/anime.db" 'SELECT COUNT(*) FROM anime')
    usuarios=$(sqlite3 "$dumps/anime.db" 'SELECT COUNT(*) FROM user')
    # Una comprobación por línea: con set -e, un fallo dentro de "a && b" no corta.
    [ "$animes" -gt 0 ]
    [ "$usuarios" -gt 0 ]

    if [ -f "$dumps/vaultwarden.db" ]; then
      step="integridad de vaultwarden.db"
      [ "$(sqlite3 "$dumps/vaultwarden.db" 'PRAGMA integrity_check')" = ok ]
      cuentas_vault=$(sqlite3 "$dumps/vaultwarden.db" 'SELECT COUNT(*) FROM users')
      [ "$cuentas_vault" -gt 0 ]
    fi

    step="volcado del panel"
    tail -n 1 "$dumps/panel.sql" | grep -q 'Dump completed'
    tablas_panel=$(grep -c '^CREATE TABLE' "$dumps/panel.sql")
    [ "$tablas_panel" -gt 20 ]

    step="lista de paquetes"
    paquetes=$(wc -l <"$dumps/paquetes.txt")
    [ "$paquetes" -gt 100 ]

    step="archivo de clientes"
    # Uno cualquiera (< 50 MB) del último backup de clientes, leído entero desde
    # Drive: su tamaño debe cuadrar con el del índice. No se mira su contenido.
    read -r cliente_size cliente_file < <(r ls latest --tag clientes --json | python3 -c '
import json, random, sys
files = []
for line in sys.stdin:
    n = json.loads(line)
    if n.get("type") == "file" and 0 < n.get("size", 0) < 50 * 2**20:
        files.append((n["size"], n["path"]))
size, path = random.choice(files)
print(size, path)')
    leidos=$(r dump --tag clientes latest "$cliente_file" | wc -c)
    [ "$leidos" -eq "$cliente_size" ]

    step="antigüedad de las copias"
    age_h() {
      r snapshots --tag "$1" --latest 1 --json | python3 -c '
import json, re, sys
from datetime import datetime, timezone
s = max(json.load(sys.stdin), key=lambda s: s["time"])
# restic da nanosegundos; fromisoformat solo admite hasta microsegundos.
t = datetime.fromisoformat(re.sub(r"(\.\d{6})\d+", r"\1", s["time"]).replace("Z", "+00:00"))
print(int((datetime.now(timezone.utc) - t).total_seconds() // 3600))'
    }
    horas_sistema=$(age_h sistema)
    horas_clientes=$(age_h clientes)
    [ "$horas_sistema" -lt 13 ]
    [ "$horas_clientes" -lt 30 ]

    step="resultado"
    simulacro_result true "animes=$animes" "usuarios=$usuarios" "tablas_panel=$tablas_panel" \
      "paquetes=$paquetes" "archivo_cliente_bytes=$leidos" \
      "horas_ultima_copia_sistema=$horas_sistema" "horas_ultima_copia_clientes=$horas_clientes"
    /usr/local/bin/discord-dm -t "🧪 Simulacro de restauración superado" -c green \
      -f "anime.db=íntegra, $animes animes, $usuarios usuarios" -f "Panel=$tablas_panel tablas" \
      -f "Clientes=archivo de $leidos bytes leído entero" \
      -f "Copias=sistema hace ${horas_sistema} h, clientes hace ${horas_clientes} h" \
      "Restaurado en $(($(date +%s) - started)) s y borrado después." || true
    ;;

  *)
    echo "Uso: server-backup sistema|clientes|nas|mantenimiento|simulacro" >&2
    exit 2
    ;;
esac

# Solo llega aquí si todo fue bien: el vigilante externo avisa si deja de
# recibir esto (ver ops-ping).
case "$mode" in
  sistema | clientes) /usr/local/bin/ops-ping "backup-$mode" ;;
  simulacro) /usr/local/bin/ops-ping simulacro ;;
esac
