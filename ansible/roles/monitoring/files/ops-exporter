#!/usr/bin/env python3
"""Exportador de Prometheus para el snapshot de ops-collect.

ops-collect deja cada 5 minutos un JSON con el estado del servidor (backups,
simulacro, SMART, certificados, servicios, fail2ban, deploys). Esto lo lee en
cada scrape y lo devuelve en el formato de texto de Prometheus. Sin
dependencias: solo la librería estándar.

Lo que ya da node_exporter (CPU, memoria, disco, red) no se repite aquí.

Variables de entorno:
  OPS_SNAPSHOT  ruta del snapshot (/var/lib/ops-collect/snapshot.json)
  OPS_LISTEN    dirección y puerto (127.0.0.1:9850)
"""

import json
import os
import sys
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

SNAPSHOT = os.environ.get("OPS_SNAPSHOT", "/var/lib/ops-collect/snapshot.json")
LISTEN = os.environ.get("OPS_LISTEN", "127.0.0.1:9850")


def escape(value):
    return str(value).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")


class Metrics:
    """Acumula series agrupadas por métrica, con su HELP y TYPE."""

    def __init__(self):
        self._metrics = {}

    def add(self, name, help_text, value, labels=None, kind="gauge"):
        if value is None:
            return
        entry = self._metrics.setdefault(name, {"help": help_text, "kind": kind, "samples": []})
        entry["samples"].append((labels or {}, float(value)))

    def render(self):
        lines = []
        for name, entry in self._metrics.items():
            lines.append(f"# HELP {name} {entry['help']}")
            lines.append(f"# TYPE {name} {entry['kind']}")
            for labels, value in entry["samples"]:
                # Sin :g, que redondea a 6 cifras y destroza los timestamps
                number = int(value) if value.is_integer() else value
                if labels:
                    inner = ",".join(f'{k}="{escape(v)}"' for k, v in sorted(labels.items()))
                    lines.append(f"{name}{{{inner}}} {number}")
                else:
                    lines.append(f"{name} {number}")
        return "\n".join(lines) + "\n"


def timestamp(iso):
    """ISO 8601 → segundos Unix. None si no se puede leer."""
    if not iso:
        return None
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def collect(snapshot):
    m = Metrics()
    m.add("ops_snapshot_up", "1 si el snapshot se ha podido leer", 1)
    m.add(
        "ops_snapshot_timestamp_seconds",
        "Cuándo lo generó ops-collect",
        timestamp(snapshot.get("collected_at")),
    )

    for mode, unit in (snapshot.get("backups") or {}).items():
        labels = {"modo": mode}
        m.add(
            "ops_backup_success",
            "1 si la última ejecución del backup terminó bien",
            1 if unit.get("Result") == "success" else 0,
            labels,
        )
        m.add(
            "ops_backup_last_start_timestamp_seconds",
            "Inicio de la última ejecución",
            unit.get("ExecMainStartTimestamp") or None,
            labels,
        )
        m.add(
            "ops_backup_last_end_timestamp_seconds",
            "Fin de la última ejecución",
            unit.get("ExecMainExitTimestamp") or None,
            labels,
        )

    restore = snapshot.get("simulacro") or {}
    if restore:
        m.add(
            "ops_restore_test_success",
            "1 si el último simulacro de restauración salió bien",
            1 if restore.get("ok") else 0,
        )
        m.add(
            "ops_restore_test_timestamp_seconds",
            "Cuándo fue el último simulacro",
            timestamp(restore.get("at")),
        )
        m.add(
            "ops_restore_test_duration_seconds",
            "Duración del último simulacro",
            restore.get("duration_s"),
        )

    for cert, info in (snapshot.get("certificates") or {}).items():
        m.add(
            "ops_cert_expiry_timestamp_seconds",
            "Caducidad del certificado",
            timestamp(info.get("expires_at")),
            {"cert": cert},
        )

    smart = snapshot.get("smart") or {}
    if smart:
        device = {"device": smart.get("device", "")}
        m.add("ops_smart_passed", "1 si SMART da el disco por bueno", 1 if smart.get("passed") else 0, device)
        m.add("ops_smart_temperature_celsius", "Temperatura del disco", smart.get("temperature_c"), device)
        wear = smart.get("wear_remaining_pct")
        m.add(
            "ops_smart_wear_remaining_ratio",
            "Vida restante del SSD (0-1)",
            wear / 100 if wear is not None else None,
            device,
        )
        m.add(
            "ops_smart_reallocated_sectors",
            "Sectores reasignados",
            smart.get("reallocated_sectors"),
            device,
        )
        m.add("ops_smart_power_on_hours", "Horas encendido", smart.get("power_on_hours"), device)

    for name, unit in (snapshot.get("services") or {}).items():
        if name.endswith(".timer"):
            continue
        m.add(
            "ops_service_active",
            "1 si la unidad systemd está activa",
            1 if unit.get("ActiveState") == "active" else 0,
            {"service": name},
        )

    for jail, info in (snapshot.get("fail2ban") or {}).items():
        labels = {"jail": jail}
        m.add("ops_fail2ban_banned", "IPs baneadas ahora mismo", len(info.get("banned") or []), labels)
        m.add(
            "ops_fail2ban_bans_since_start",
            "Baneos desde que arrancó fail2ban",
            info.get("total_banned"),
            labels,
        )

    deploys = snapshot.get("deploys") or {}
    m.add(
        "ops_deploy_timestamp_seconds",
        "Cuándo se activó la versión de Bentonime en marcha",
        timestamp(deploys.get("bentonime_deployed_at")),
    )
    last = deploys.get("last_deploy") or {}
    if last:
        m.add(
            "ops_deploy_last_ok",
            "1 si el último deploy terminó bien (0 si falló o hizo rollback)",
            1 if last.get("phase") == "ok" else 0,
        )
    return m


def render(path=SNAPSHOT):
    try:
        with open(path) as f:
            snapshot = json.load(f)
    except (OSError, ValueError) as err:
        print(f"no se puede leer {path}: {err}", file=sys.stderr)
        m = Metrics()
        m.add("ops_snapshot_up", "1 si el snapshot se ha podido leer", 0)
        return m.render()
    return collect(snapshot).render()


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path != "/metrics":
            self.send_error(404)
            return
        body = render().encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; version=0.0.4; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


def main():
    host, port = LISTEN.rsplit(":", 1)
    server = ThreadingHTTPServer((host, int(port)), Handler)
    print(f"ops-exporter en http://{LISTEN}/metrics, leyendo {SNAPSHOT}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
