#!/usr/bin/env python3
"""Receptor de webhooks de Alertmanager que manda cada aviso por DM de Discord.

Alertmanager solo sabe escribir en canales (webhook de Discord); los avisos del
servidor van por DM, así que esto traduce su JSON a una llamada a discord-dm.

Variables de entorno:
  ALERT_DM_LISTEN  dirección y puerto (127.0.0.1:9851)
  DISCORD_DM       ruta de discord-dm (/usr/local/bin/discord-dm)
"""

import json
import os
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

LISTEN = os.environ.get("ALERT_DM_LISTEN", "127.0.0.1:9851")
DISCORD_DM = os.environ.get("DISCORD_DM", "/usr/local/bin/discord-dm")
MAX_BODY = 1024 * 1024


def message(alert, status):
    """Argumentos de discord-dm para una alerta."""
    labels = alert.get("labels", {})
    notes = alert.get("annotations", {})
    name = labels.get("alertname", "Alerta")
    if status == "resolved":
        title, color = f"✅ Resuelto: {name}", "green"
    else:
        color = "red" if labels.get("severity") == "critical" else "amber"
        title = f"🚨 {name}"
    args = [DISCORD_DM, "-t", title, "-c", color]
    for key in ("servicio", "instance", "mountpoint"):
        if labels.get(key):
            args += ["-f", f"{key.capitalize()}={labels[key]}"]
    args.append(notes.get("summary") or notes.get("description") or name)
    return args


def notify(payload):
    status = payload.get("status", "firing")
    sent = 0
    for alert in payload.get("alerts", []):
        result = subprocess.run(message(alert, alert.get("status", status)), capture_output=True, text=True)
        if result.returncode != 0:
            print(f"discord-dm falló: {result.stderr.strip()}", file=sys.stderr)
            continue
        sent += 1
    return sent


class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        if self.path != "/alertmanager":
            self.send_error(404)
            return
        length = int(self.headers.get("Content-Length") or 0)
        if length <= 0 or length > MAX_BODY:
            self.send_error(400)
            return
        try:
            payload = json.loads(self.rfile.read(length))
        except ValueError:
            self.send_error(400)
            return
        # Si no sale ninguno, 500: Alertmanager lo reintenta
        alerts = payload.get("alerts", [])
        if alerts and notify(payload) == 0:
            self.send_error(500)
            return
        self.send_response(204)
        self.end_headers()

    def log_message(self, *args):
        pass


def main():
    host, port = LISTEN.rsplit(":", 1)
    server = ThreadingHTTPServer((host, int(port)), Handler)
    print(f"alert-dm escuchando en http://{LISTEN}/alertmanager", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
