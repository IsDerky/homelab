#!/usr/bin/env python3
"""Receptor de webhooks de Alertmanager que manda cada aviso por DM de Discord.

Alertmanager solo sabe escribir en canales (webhook de Discord); los avisos del
servidor van por DM, así que esto traduce su JSON a una llamada a discord-dm.

La alerta Watchdog (siempre activa) no va por DM: si hay OPS_PING, se avisa con
él al vigilante externo, que salta si deja de llegar. Sin OPS_PING se ignora.

Variables de entorno:
  ALERT_DM_LISTEN  dirección y puerto (127.0.0.1:9851)
  DISCORD_DM       ruta de discord-dm (/usr/local/bin/discord-dm)
  OPS_PING         ruta de ops-ping (vacío = el latido no sale de aquí)
  CAMBIOS          eventos de cambios-recoger: los de las horas antes del aviso
                   salen en el DM («Cambios (2 h)»); vacío o sin fichero, nada
"""

import json
import os
import re
import subprocess
import sys
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

LISTEN = os.environ.get("ALERT_DM_LISTEN", "127.0.0.1:9851")
DISCORD_DM = os.environ.get("DISCORD_DM", "/usr/local/bin/discord-dm")
OPS_PING = os.environ.get("OPS_PING", "")
CAMBIOS = os.environ.get("CAMBIOS", "/var/lib/cambios/eventos.jsonl")
CAMBIOS_VENTANA = 2 * 3600
CAMBIOS_MAX = 5
LATIDO = "Watchdog"
MAX_BODY = 1024 * 1024


def cambios_antes(empieza):
    """Líneas «HH:MM texto» de los cambios en las 2 h antes de que empezase la alerta (más recientes primero)."""
    if not CAMBIOS or not os.path.exists(CAMBIOS):
        return []
    try:
        # Alertmanager da nanosegundos y «Z»: fromisoformat de Python 3.10 no los entiende
        t0 = datetime.fromisoformat(re.sub(r"\.\d+", "", empieza).replace("Z", "+00:00")).timestamp()
    except (ValueError, TypeError):
        return []
    eventos = []
    try:
        with open(CAMBIOS) as f:
            for linea in f:
                try:
                    e = json.loads(linea)
                except ValueError:
                    continue
                if t0 - CAMBIOS_VENTANA <= e.get("t", 0) <= t0 + 60:
                    eventos.append(e)
    except OSError:
        return []
    eventos.sort(key=lambda e: -e["t"])
    return [f"{datetime.fromtimestamp(e['t']).strftime('%H:%M')} {e['texto'][:150]}" for e in eventos[:CAMBIOS_MAX]]


def message(alert, status):
    """Argumentos de discord-dm para una alerta."""
    labels = alert.get("labels", {})
    notes = alert.get("annotations", {})
    name = labels.get("alertname", "Alerta")
    if status == "resolved":
        title, color = f"✅ Resuelto: {name}", "green"
    else:
        color = "red" if labels.get("severity") == "critical" else "amber"
        title = f"🚨 {name}"
    args = [DISCORD_DM, "-t", title, "-c", color]
    for key in ("servicio", "servidor", "instance", "mountpoint"):
        if labels.get(key):
            args += ["-f", f"{key.capitalize()}={labels[key]}"]
    if status != "resolved":
        cambios = cambios_antes(alert.get("startsAt", ""))
        if cambios:
            args += ["-f", "Cambios (2 h)=" + "\n".join(cambios)]
    args.append(notes.get("summary") or notes.get("description") or name)
    return args


def notify(payload):
    status = payload.get("status", "firing")
    sent = 0
    for alert in payload.get("alerts", []):
        if alert.get("labels", {}).get("alertname") == LATIDO:
            # ops-ping nunca falla hacia fuera: cuenta como enviado igual
            if OPS_PING and alert.get("status", status) == "firing":
                subprocess.run([OPS_PING, "alertas"], capture_output=True, text=True)
            sent += 1
            continue
        result = subprocess.run(message(alert, alert.get("status", status)), capture_output=True, text=True)
        if result.returncode != 0:
            print(f"discord-dm falló: {result.stderr.strip()}", file=sys.stderr)
            continue
        sent += 1
    return sent


class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        if self.path != "/alertmanager":
            self.send_error(404)
            return
        length = int(self.headers.get("Content-Length") or 0)
        if length <= 0 or length > MAX_BODY:
            self.send_error(400)
            return
        try:
            payload = json.loads(self.rfile.read(length))
        except ValueError:
            self.send_error(400)
            return
        # Si no sale ninguno, 500: Alertmanager lo reintenta
        alerts = payload.get("alerts", [])
        if alerts and notify(payload) == 0:
            self.send_error(500)
            return
        self.send_response(204)
        self.end_headers()

    def log_message(self, *args):
        pass


def main():
    host, port = LISTEN.rsplit(":", 1)
    server = ThreadingHTTPServer((host, int(port)), Handler)
    print(f"alert-dm escuchando en http://{LISTEN}/alertmanager", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
