      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "range": true,
          "instant": false,
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{job=\"nodos\", nodo=\"$nodo\", mode!=\"idle\"}[5m])) / scalar(count(node_cpu_seconds_total{job=\"nodos\", nodo=\"$nodo\", mode=\"idle\"}))",
          "legendFormat": "{{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 30,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
