          },
          "expr": "slo:probe_errors:ratio_rate1h{servicio=\"bentonime\"}",
          "legendFormat": "fallos 1 h",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "14.4 * (1 - slo:objetivo{servicio=\"bentonime\"})",
          "legendFormat": "umbral de alerta",
          "refId": "B"
