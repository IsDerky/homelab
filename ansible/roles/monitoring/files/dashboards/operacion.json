      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "description": "La alerta salta cuando esto y la ventana de 5 min pasan el umbral (14,4 veces el ritmo permitido)."
