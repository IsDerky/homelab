#!/usr/bin/env python3
"""Estado de unidades systemd para el colector textfile de node-exporter.

El colector systemd de node-exporter pregunta a systemd por D-Bus, y el perfil
docker-default de AppArmor no deja al contenedor hablar con el bus. En vez de
quitarle AppArmor, esto corre en el host con un timer y escribe
node_systemd_unit_state (mismo nombre y etiquetas que el colector) en un .prom
que node-exporter lee del disco. De los timers, además, la última vez que se
dispararon (node_systemd_timer_last_trigger_seconds).

Uso: systemd-textfile FICHERO REGEX...
Las regex se comparan con el nombre completo (nginx.service, certbot.timer).
"""

import calendar
import os
import re
import subprocess
import sys
import tempfile
import time

STATES = ("activating", "active", "deactivating", "failed", "inactive")


def escape(value):
    return str(value).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")


def parse(text):
    """Salida de `systemctl list-units --plain --no-legend` → {unidad: ActiveState}."""
    units = {}
    for line in text.splitlines():
        parts = line.split(None, 4)
        if len(parts) >= 4:
            units[parts[0]] = parts[2]
    return units


def parse_triggers(text):
    """Salida de `systemctl show -p Id -p LastTriggerUSec` con TZ=UTC → {timer: epoch}.

    show no hace caso de --timestamp=unix: la fecha sale como
    "Tue 2026-11-10 10:48:00 UTC". Vacía si no se ha disparado desde el arranque.
    """
    triggers = {}
    for block in text.split("\n\n"):
        props = dict(line.split("=", 1) for line in block.splitlines() if "=" in line)
        try:
            stamp = time.strptime(props["LastTriggerUSec"], "%a %Y-%m-%d %H:%M:%S UTC")
        except (KeyError, ValueError):
            continue
        triggers[props["Id"]] = calendar.timegm(stamp)
    return triggers


def selected(units, patterns):
    include = re.compile("^(?:" + "|".join(patterns) + ")$")
    return sorted(u for u in units if include.match(u))


def render(units, patterns, triggers=None):
    lines = [
        "# HELP node_systemd_unit_state Estado de la unidad systemd (systemd-textfile)",
        "# TYPE node_systemd_unit_state gauge",
    ]
    for name in selected(units, patterns):
        for state in STATES:
            value = int(units[name] == state)
            lines.append(f'node_systemd_unit_state{{name="{escape(name)}",state="{state}"}} {value}')
    if triggers:
        lines += [
            "# HELP node_systemd_timer_last_trigger_seconds Última vez que se disparó el timer (systemd-textfile)",
            "# TYPE node_systemd_timer_last_trigger_seconds gauge",
        ]
        for name in sorted(triggers):
            lines.append(f'node_systemd_timer_last_trigger_seconds{{name="{escape(name)}"}} {triggers[name]}')
    return "\n".join(lines) + "\n"


def write(path, content):
    # Escritura atómica: node-exporter nunca ve el fichero a medias
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".systemd-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def main():
    if len(sys.argv) < 3:
        sys.exit("Uso: systemd-textfile FICHERO REGEX...")
    out = subprocess.run(
        ["systemctl", "list-units", "--all", "--plain", "--no-legend", "--no-pager", "--full"],
        capture_output=True, text=True, check=True,
    ).stdout
    units = parse(out)
    patterns = sys.argv[2:]
    timers = [u for u in selected(units, patterns) if u.endswith(".timer")]
    triggers = {}
    if timers:
        show = subprocess.run(
            ["systemctl", "show", "--no-pager", "-p", "Id", "-p", "LastTriggerUSec", *timers],
            capture_output=True, text=True, check=True,
            env={**os.environ, "TZ": "UTC", "LC_ALL": "C"},
        ).stdout
        triggers = parse_triggers(show)
    write(sys.argv[1], render(units, patterns, triggers))


if __name__ == "__main__":
    main()
