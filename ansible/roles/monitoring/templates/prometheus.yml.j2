# {{ ansible_managed }}
global:
  scrape_interval: {{ monitoring_scrape_interval }}
  evaluation_interval: {{ monitoring_scrape_interval }}

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:{{ monitoring_ports.alertmanager }}"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:{{ monitoring_ports.prometheus }}"]

  - job_name: alertmanager
    static_configs:
      - targets: ["127.0.0.1:{{ monitoring_ports.alertmanager }}"]

  - job_name: node
    static_configs:
      - targets: ["127.0.0.1:{{ monitoring_ports.node_exporter }}"]
{% if monitoring_remote_nodes %}

  # node-exporter de los nodos de fuera, por el túnel
  - job_name: nodos
    static_configs:
{% for nodo in monitoring_remote_nodes %}
      - targets: ["{{ nodo.target }}"]
        labels:
          nodo: {{ nodo.nombre }}
{% endfor %}
{% endif %}
{% if monitoring_ops_group %}

  - job_name: ops
    static_configs:
      - targets: ["127.0.0.1:{{ monitoring_ports.ops_exporter }}"]
{% endif %}
{% if monitoring_cadvisor %}

  - job_name: cadvisor
    static_configs:
      - targets: ["127.0.0.1:{{ monitoring_ports.cadvisor }}"]
{% endif %}
{% if monitoring_tls_probes %}

  - job_name: tls
    metrics_path: /probe
    params:
      module: [tls]
    static_configs:
{% for probe in monitoring_tls_probes %}
      - targets: ["{{ probe.url }}"]
        labels:
          nombre: {{ probe.nombre }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_ports.blackbox }}
{% endif %}
{% if monitoring_content_probes %}

  # Más despacio que el resto: la alerta mira el último valor, no el instante
  - job_name: contenido
    metrics_path: /probe
    scrape_interval: {{ monitoring_content_interval }}
    scrape_timeout: 90s
    static_configs:
{% for probe in monitoring_content_probes %}
      - targets: ["{{ probe.url }}"]
        labels:
          nombre: {{ probe.nombre }}
          __param_module: contenido_{{ probe.nombre }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_ports.blackbox }}
{% endif %}
{% if monitoring_http_probes %}

  # blackbox hace la petición; aquí cada destino pasa a ser un parámetro
  - job_name: blackbox
    metrics_path: /probe
    static_configs:
{% for probe in monitoring_http_probes %}
      - targets: ["{{ probe.url }}"]
        labels:
          servicio: {{ probe.servicio }}
          __param_module: http_{{ probe.servicio }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_ports.blackbox }}
{% endif %}
