# {{ ansible_managed }}
# Todo con la red del host y escuchando solo en 127.0.0.1. Los puertos que
# publica Docker se saltan ufw; así no se publica ninguno.
# La configuración se monta por carpetas, no fichero a fichero: Ansible
# reemplaza los ficheros (nuevo inodo) y un montaje de fichero suelto seguiría
# viendo el viejo, así que el SIGHUP recargaría la configuración anterior.
name: monitoring

services:
  prometheus:
    image: {{ monitoring_images.prometheus }}
    network_mode: host
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ monitoring_retention_time }}
      - --storage.tsdb.retention.size={{ monitoring_retention_size }}
      - --web.listen-address=127.0.0.1:{{ monitoring_ports.prometheus }}
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - ./data/prometheus:/prometheus
    mem_limit: {{ monitoring_mem.prometheus }}
    restart: unless-stopped

  alertmanager:
    image: {{ monitoring_images.alertmanager }}
    network_mode: host
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      - --web.listen-address=127.0.0.1:{{ monitoring_ports.alertmanager }}
      # Una sola instancia: sin el puerto de cluster (9094)
      - --cluster.listen-address=
    volumes:
      - ./alertmanager:/etc/alertmanager:ro
      - ./data/alertmanager:/alertmanager
    mem_limit: {{ monitoring_mem.alertmanager }}
    restart: unless-stopped

  blackbox:
    image: {{ monitoring_images.blackbox }}
    network_mode: host
    command:
      - --config.file=/etc/blackbox/blackbox.yml
      - --web.listen-address=127.0.0.1:{{ monitoring_ports.blackbox }}
    volumes:
      - ./blackbox:/etc/blackbox:ro
    mem_limit: {{ monitoring_mem.blackbox }}
    restart: unless-stopped

  node-exporter:
    image: {{ monitoring_images.node_exporter }}
    network_mode: host
    pid: host
    command:
      - --path.rootfs=/host
      - --web.listen-address=127.0.0.1:{{ monitoring_ports.node_exporter }}
{% if monitoring_systemd_units %}
      # Estado de las unidades de la lista (por D-Bus); todas serían cientos de series
      - --collector.systemd
      - --collector.systemd.unit-include=({{ monitoring_systemd_units | join('|') }})
{% endif %}
    volumes:
      - /:/host:ro,rslave
{% if monitoring_systemd_units %}
      - /run/dbus/system_bus_socket:/var/run/dbus/system_bus_socket:ro
{% endif %}
    mem_limit: {{ monitoring_mem.node_exporter }}
    restart: unless-stopped

{% if monitoring_cadvisor %}
  # Consumo por contenedor (incluidos los de Wings). Solo métricas de CPU,
  # memoria, red, E/S y presión: el resto (uso de disco por capa, procesos,
  # TCP...) dispara las series y la CPU de cAdvisor sin aportar mucho.
  cadvisor:
    image: {{ monitoring_images.cadvisor }}
    network_mode: host
    privileged: true
    devices:
      - /dev/kmsg
    command:
      - --listen_ip=127.0.0.1
      - --port={{ monitoring_ports.cadvisor }}
      - --docker_only=true
      - --housekeeping_interval=30s
      - --store_container_labels=false
      - --disable_metrics=advtcp,cpu_topology,cpuset,disk,hugetlb,memory_numa,percpu,perf_event,process,referenced_memory,resctrl,sched,tcp,udp
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk:/dev/disk:ro
    mem_limit: {{ monitoring_mem.cadvisor }}
    restart: unless-stopped

{% endif %}
  grafana:
    image: {{ monitoring_images.grafana }}
    network_mode: host
    env_file: grafana.env
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - ./data/grafana:/var/lib/grafana
    mem_limit: {{ monitoring_mem.grafana }}
    restart: unless-stopped
