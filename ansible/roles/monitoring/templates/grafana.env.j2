# {{ ansible_managed }}
GF_SERVER_HTTP_ADDR=127.0.0.1
GF_SERVER_HTTP_PORT={{ monitoring_ports.grafana }}
GF_SERVER_ROOT_URL={{ monitoring_grafana_root_url }}
GF_SERVER_SERVE_FROM_SUB_PATH={{ 'true' if (monitoring_grafana_root_url | urlsplit('path')) not in ['', '/'] else 'false' }}
GF_SECURITY_ADMIN_PASSWORD={{ monitoring_grafana_admin_password }}
GF_SECURITY_COOKIE_SECURE={{ 'true' if monitoring_grafana_root_url.startswith('https') else 'false' }}
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED={{ monitoring_grafana_anonymous_viewer | lower }}
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_NEWS_NEWS_FEED_ENABLED=false
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/servidor.json
