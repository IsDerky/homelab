# {{ ansible_managed }}
# HELP caducidad_timestamp_segundos Cuándo caduca algo que no se puede comprobar desde aquí (monitoring_caducidades)
# TYPE caducidad_timestamp_segundos gauge
{% for c in monitoring_caducidades %}
{% set f = c.fecha | string | to_datetime('%Y-%m-%d') %}
caducidad_timestamp_segundos{nombre="{{ c.nombre }}",corto="{{ c.corto | default('') }}",fecha="{{ f.strftime('%d-%m-%Y') }}",renovar="{{ c.renovar | default('') }}"} {{ f.strftime('%s') }}
{% endfor %}
