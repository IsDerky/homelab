# {{ ansible_managed }}
route:
  receiver: {{ 'discord' if monitoring_alert_dm else 'nadie' }}
  group_by: [alertname, servicio]
  group_wait: 30s
  group_interval: 5m
  # Como el vigilante externo: si sigue igual, un recordatorio al día
  repeat_interval: 24h
{% if monitoring_alert_dm %}
  routes:
    # Latido: cada 10 min a alert-dm, que no lo manda por DM sino al vigilante externo
    # (cada latido es una escritura en su KV)
    - matchers: ['alertname="Watchdog"']
      receiver: discord
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 10m
    # Caducidades: un solo DM por aviso (30 y 7 días), sin recordatorio diario
    # ni «Resuelto» al renovar. Que no se repita depende de que el registro de
    # avisos dure más que la alerta: --data.retention en el compose.
    - matchers: ['aviso="caducidad"']
      receiver: discord-sin-resuelto
      group_by: [alertname, nombre]
      repeat_interval: 8760h
{% endif %}

receivers:
  - name: nadie
{% if monitoring_alert_dm %}
  - name: discord
    webhook_configs:
      - url: http://127.0.0.1:{{ monitoring_ports.alert_dm }}/alertmanager
        send_resolved: true
  - name: discord-sin-resuelto
    webhook_configs:
      - url: http://127.0.0.1:{{ monitoring_ports.alert_dm }}/alertmanager
        send_resolved: false
{% endif %}
